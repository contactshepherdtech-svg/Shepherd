# Client-safe Supabase settings (staging values for local development)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Planning Center OAuth and sync
PLANNING_CENTER_CLIENT_ID=
PLANNING_CENTER_CLIENT_SECRET=
PLANNING_CENTER_REDIRECT_URI=http://localhost:3000/api/planning-center/callback
PLANNING_CENTER_SYNC_MAX_PAGES=100

# Google / Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Sign OAuth state tokens with a distinct, long random secret.
OAUTH_STATE_SECRET=

# AI-assisted outreach (optional until outreach generation is enabled)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Python ingestion/scoring database connection
DATABASE_URL=
SHEPHERD_ACTIVE_CHURCH_ID=
